# Local .env for the HAKATHON Streamlit app.
# For Streamlit Cloud, paste the same keys into App settings -> Secrets as
# TOML (root level, no [section]). NEVER commit the real .env.

# ---- Required ----
GEMINI_API_KEY=your-google-ai-studio-key

# ---- Models ----
# GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_SECONDS=60           # per-request LLM timeout (HTTP_TIMEOUT_SECONDS is for stock lookups)
# LLM_CLIENT_MAX_RETRIES=2         # SDK retries per LLM request

# ---- Embeddings (choose one provider) ----
# EMBEDDING_PROVIDER=jina            # "jina" (default, free tier) or "google"
# Jina free tier (https://jina.ai/embeddings/; default provider)
JINA_API_KEY=your-jina-api-key
# JINA_EMBEDDING_MODEL=jina-embeddings-v4
# JINA_EMBEDDING_BATCH_SIZE=32
# Reranking uses the SAME JINA_API_KEY (no separate key needed).
# JINA_RERANK_MODEL=jina-reranker-v3.5
# RERANK_ENABLED=true
# RERANK_TIMEOUT_SECONDS=20
# Google Gemini embeddings (requires GEMINI_API_KEY above)
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_EMBEDDING_BATCH_SIZE=32

# ---- Optional: stocks ----
# ALPHAVANTAGE_API_KEY=your-alphavantage-key
# HTTP_TIMEOUT_SECONDS=10

# ---- Optional: search ----
# DUCKDUCKGO_REGION=us-en
# SEARCH_MAX_RETRIES=3
# SEARCH_RETRY_BACKOFF_SECONDS=2.0

# ---- Optional: scheduler / storage ----
# WAIT_MAX_SECONDS=3600
# MAX_SCHEDULE_INTERVAL_MINUTES=10080
# MAX_AUTO_RUNS=20
# HAKATHON_DATA_DIR=.hakathon

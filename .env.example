# Copy required values into Streamlit Cloud -> App settings -> Secrets
# (TOML format), or a local .env file. NEVER commit the real .env.

# ---- Required ----
GEMINI_API_KEY=your-google-ai-studio-key

# ---- Optional: models ----
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Embeddings (choose one provider) ----
# EMBEDDING_PROVIDER=jina          # "jina" (default, free tier) or "google"
# Jina free tier (https://jina.ai/embeddings/; default provider)
JINA_API_KEY=your-jina-api-key
# JINA_EMBEDDING_MODEL=jina-embeddings-v4
# JINA_EMBEDDING_BATCH_SIZE=100
# Google Gemini embeddings (requires GEMINI_API_KEY above)
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_EMBEDDING_BATCH_SIZE=100

# ---- Optional: search ----
# DUCKDUCKGO_REGION=us-en
# SEARCH_MAX_RETRIES=3
# SEARCH_RETRY_BACKOFF_SECONDS=2.0

# ---- Gmail MCP (requires local Node + gmail-mcp build; leave disabled on cloud) ----
GMAIL_MCP_ENABLED=false
# GMAIL_MCP_COMMAND=node
# GMAIL_MCP_ARGS=/absolute/path/to/gmail-mcp/dist/index.js
# GMAIL_MCP_PORT=0

# ---- Gmail per-user OAuth 2.0 (for hosted deployments) ----
# Each visitor authenticates with their own Google account via the consent screen.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API at https://console.cloud.google.com/apis/library/gmail.googleapis.com
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8501

# ---- Waggle MCP memory (leave disabled on cloud; PyPI build lacks the
# local Jina-backend patch) ----
WAGGLE_MCP_ENABLED=false
# WAGGLE_MCP_COMMAND=waggle-mcp
# WAGGLE_EMBEDDING_BACKEND=jina
# WAGGLE_DB_PATH=.hakathon/waggle/memory.db

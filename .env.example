# Optional local settings for the HAKATHON Streamlit app.
# The Gemini API key is NOT stored here: each user pastes it into the sidebar
# at runtime. NEVER commit real credentials.

# ---- Models ----
# GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_SECONDS=60           # per-request LLM timeout (HTTP_TIMEOUT_SECONDS is for stock lookups)
# LLM_CLIENT_MAX_RETRIES=2         # SDK retries per LLM request

# ---- Embeddings (Gemini; optional tuning) ----
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_EMBEDDING_BATCH_SIZE=32

# ---- Optional: stocks ----
# ALPHAVANTAGE_API_KEY=your-alphavantage-key
# HTTP_TIMEOUT_SECONDS=10

# ---- Optional: search ----
# DUCKDUCKGO_REGION=us-en
# SEARCH_MAX_RETRIES=3
# SEARCH_RETRY_BACKOFF_SECONDS=2.0

# ---- Optional: scheduler / storage ----
# WAIT_MAX_SECONDS=3600
# MAX_SCHEDULE_INTERVAL_MINUTES=10080
# MAX_AUTO_RUNS=20
# HAKATHON_DATA_DIR=.hakathon

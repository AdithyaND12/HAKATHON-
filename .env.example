# Copy required values into Streamlit Cloud -> App settings -> Secrets
# (TOML format), or a local .env file. NEVER commit the real .env.

# ---- Required ----
GEMINI_API_KEY=your-google-ai-studio-key
JINA_API_KEY=your-jina-api-key

# ---- Optional: models ----
# GEMINI_MODEL=gemini-3.5-flash-lite
# JINA_EMBEDDING_MODEL=jina-embeddings-v4
# JINA_EMBEDDING_BATCH_SIZE=100

# ---- Optional: search ----
# DUCKDUCKGO_REGION=us-en
# SEARCH_MAX_RETRIES=3
# SEARCH_RETRY_BACKOFF_SECONDS=2.0

# ---- Gmail MCP (requires local Node + gmail-mcp build; leave disabled on cloud) ----
GMAIL_MCP_ENABLED=false
# GMAIL_MCP_COMMAND=node
# GMAIL_MCP_ARGS=/absolute/path/to/gmail-mcp/dist/index.js
# GMAIL_MCP_PORT=0

# ---- Waggle MCP memory (leave disabled on cloud; PyPI build lacks the
# local Jina-backend patch) ----
WAGGLE_MCP_ENABLED=false
# WAGGLE_MCP_COMMAND=waggle-mcp
# WAGGLE_EMBEDDING_BACKEND=jina
# WAGGLE_DB_PATH=.hakathon/waggle/memory.db
